          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edgeConsumerToMongo" value="5. Upsert atómico por source_version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#486581;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334E68;labelBackgroundColor=#FFFFFF;" edge="1" parent="cdcBoundary" source="projectionConsumer" target="mongoReadModel">
