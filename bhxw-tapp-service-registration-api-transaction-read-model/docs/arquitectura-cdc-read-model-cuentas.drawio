        <mxCell id="coreInternal" value="Escritura transaccional" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A46B12;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#7A4C00;labelBackgroundColor=#FFFDF7;" edge="1" parent="coreBoundary" source="coreInterfaces" target="coreDb">
