  <diagram id="cdc-account-read-model" name="Arquitectura CDC">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Arquitectura CDC para el Read Model de cuentas&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontColor=#183B56;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Captura de cambios confirmados, publicación en Kafka y proyección de baja latencia en MongoDB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#5F6C7B;" vertex="1" parent="1">
