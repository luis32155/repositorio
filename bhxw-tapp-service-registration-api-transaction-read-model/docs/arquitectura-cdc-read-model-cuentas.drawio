              <mxPoint x="788" y="295"/>
              <mxPoint x="765" y="295"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edgeConsumerToDlq" value="Error permanente / reintentos agotados" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 4;strokeColor=#7F8C8D;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#4A5560;labelBackgroundColor=#FFFFFF;" edge="1" parent="cdcBoundary" source="projectionConsumer" target="retryDlq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edgeQueryToMongo" value="7. Lee proyección" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#486581;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334E68;labelBackgroundColor=#FFFFFF;" edge="1" parent="cdcBoundary" source="queryApi" target="mongoReadModel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edgeOrchestratorToQuery" value="6. Validación temprana" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8064A2;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#5B4376;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="orchestrator" target="queryApi">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edgeOrchestratorToCore" value="8. Validación y ejecución definitiva" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8064A2;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=11;fontColor=#5B4376;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="orchestrator" target="coreInterfaces">
