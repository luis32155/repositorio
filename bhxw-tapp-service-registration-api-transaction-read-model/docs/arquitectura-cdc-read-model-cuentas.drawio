          <mxGeometry x="660" y="500" width="210" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="freshnessNote" value="&lt;b&gt;Objetivo del PoC&lt;/b&gt;&lt;br&gt;Lag end-to-end p99 ≤ 3 segundos en operación normal" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontColor=#5B3A00;" vertex="1" parent="cdcBoundary">
          <mxGeometry x="35" y="475" width="270" height="95" as="geometry"/>
        </mxCell>

