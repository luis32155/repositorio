          <mxGeometry x="1330" y="390" width="230" height="115" as="geometry"/>
        </mxCell>

        <!-- Main flow edges -->
        <mxCell id="edgeCoreToCdc" value="1. Lectura de cambios confirmados" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#486581;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334E68;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="coreDb" target="cdcTechnology">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edgeCdcToNormalizer" value="2. Cambio + posición" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#486581;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334E68;labelBackgroundColor=#FFFFFF;" edge="1" parent="cdcBoundary" source="cdcTechnology" target="normalizer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edgeNormalizerToKafka" value="3. Publica AccountStateChanged" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#486581;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#334E68;labelBackgroundColor=#FFFFFF;" edge="1" parent="cdcBoundary" source="normalizer" target="kafkaTopic">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
