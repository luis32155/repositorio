          </mxGeometry>
        </mxCell>

        <!-- Important note -->
        <mxCell id="authorityNote" value="&lt;b&gt;Regla fundamental&lt;/b&gt;&lt;br&gt;El Read Model tiene consistencia eventual. Si el dato está STALE, ausente o no disponible, el Orchestrator debe aplicar fallback al Core. MongoDB no autoriza el débito." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDE9E7;strokeColor=#C0504D;strokeWidth=2;fontSize=12;fontColor=#7A2422;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
