{
  "openapi": "3.1.0",
  "info": {
    "title": "Customer Profile API",
    "version": "1.0.0-draft",
    "description": "Consulta unificada del perfil de un cliente desde el modelo de lectura Customer.",
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://api-dev.example.bank/customer-profile",
      "description": "URL referencial de desarrollo"
    }
  ],
  "tags": [
    {
      "name": "Customer Profile",
      "description": "Operaciones de consulta del perfil materializado del cliente."
    }
  ],
  "paths": {
    "/v1/customers/{customer_id}/profile": {
      "get": {
        "tags": [
          "Customer Profile"
        ],
        "operationId": "getCustomerProfile",
        "summary": "Consultar perfil del cliente",
        "description": "Retorna el perfil materializado del cliente. La referencia funcional mostrada en los diagramas es API Person / B28.",
        "x-core-transactions": [
          "B28"
        ],
        "security": [
          {
            "siaOAuth2": [
              "customer.read"
            ],
            "apiKeyAuth": [],
            "mutualTLS": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CustomerId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/ChannelId"
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil encontrado",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerProfileResponse"
                },
                "examples": {
                  "active_customer": {
                    "value": {
                      "data": {
                        "customer_id": "CUS-100045",
                        "document": {
                          "type": "DNI",
                          "masked_number": "******42"
                        },
                        "name": {
                          "given_names": "Ana María",
                          "family_names": "Torres Ruiz"
                        },
                        "status": "ACTIVE",
                        "contact": {
                          "masked_email": "a***@example.com",
                          "masked_mobile": "******789"
                        },
                        "last_updated_at": "2026-08-25T15:30:00Z"
                      },
                      "meta": {
                        "correlation_id": "80a71e5a-61c1-4f72-84f8-57d83f4d1672"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key emitida y validada por Apigee para el canal autorizado."
      },
      "mutualTLS": {
        "type": "mutualTLS",
        "description": "Certificado cliente validado en las capas Akamai/Apigee."
      },
      "siaOAuth2": {
        "type": "oauth2",
        "description": "Integración OAuth 2.0 con Secure Integrated Authentication (SIA).",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://sia.example.bank/oauth2/token",
            "scopes": {
              "customer.read": "Consultar información de clientes"
            }
          }
        }
      }
    },
    "parameters": {
      "CustomerId": {
        "name": "customer_id",
        "in": "path",
        "required": true,
        "description": "Identificador interno, opaco y estable del cliente.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ChannelId": {
        "name": "X-Channel-Id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30,
          "pattern": "^[A-Z0-9_-]+$",
          "examples": [
            "TAPP",
            "JOY",
            "TBK",
            "NEW_FLOW"
          ]
        }
      }
    },
    "headers": {
      "CorrelationId": {
        "description": "Identificador de trazabilidad recibido en la solicitud.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "CustomerProfileResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CustomerProfile"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        }
      },
      "CustomerProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customer_id",
          "document",
          "name",
          "status",
          "last_updated_at"
        ],
        "properties": {
          "customer_id": {
            "type": "string",
            "maxLength": 64
          },
          "document": {
            "$ref": "#/components/schemas/IdentityDocument"
          },
          "name": {
            "$ref": "#/components/schemas/PersonalName"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "BLOCKED",
              "DECEASED",
              "UNKNOWN"
            ]
          },
          "contact": {
            "$ref": "#/components/schemas/MaskedContact"
          },
          "segment": {
            "type": "string",
            "maxLength": 50
          },
          "last_updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "IdentityDocument": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "masked_number"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "DNI",
              "CE",
              "PASSPORT",
              "RUC",
              "OTHER"
            ]
          },
          "masked_number": {
            "type": "string",
            "minLength": 4,
            "maxLength": 32
          }
        }
      },
      "PersonalName": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "given_names",
          "family_names"
        ],
        "properties": {
          "given_names": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "family_names": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      },
      "MaskedContact": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "masked_email": {
            "type": "string",
            "maxLength": 254
          },
          "masked_mobile": {
            "type": "string",
            "maxLength": 32
          }
        }
      },
      "ResponseMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "correlation_id"
        ],
        "properties": {
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlation_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "maxLength": 80
          },
          "detail": {
            "type": "string",
            "maxLength": 1000
          },
          "instance": {
            "type": "string",
            "maxLength": 200
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "errors": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "maxLength": 120
                },
                "message": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Solicitud inválida",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Credenciales ausentes o inválidas",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "El cliente autenticado no posee el alcance requerido",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "Cliente no encontrado",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Límite de solicitudes excedido",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InternalError": {
        "description": "Error interno no esperado",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Servicio o dependencia temporalmente no disponible",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  },
  "x-contract-scope": "INTERNAL_DRAFT_NOT_NIUBIZ"
}