{
  "openapi": "3.1.0",
  "info": {
    "title": "Juspay Peru CBS API",
    "version": "1.0.0-draft",
    "description": "Contrato canónico de integración entre Niubiz/Juspay y el CBS, derivado de \"Juspay-Peru CBS API Specs\". El documento fuente define cuerpos y semántica, pero no URLs, métodos HTTP, seguridad ni catálogos generales de estado; esos elementos se declaran aquí como propuesta de implementación.",
    "license": {
      "name": "Proprietary",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://api-dev.example.bank",
      "description": "URL referencial; debe sustituirse por el virtual host de Apigee."
    }
  ],
  "security": [
    {
      "apiKeyAuth": [],
      "mutualTLS": []
    }
  ],
  "tags": [
    {
      "name": "Account Provider",
      "description": "Descubrimiento de cuentas, validación de tarjeta y consulta de saldo."
    },
    {
      "name": "Money Movement",
      "description": "Operaciones CBS de crédito y débito."
    },
    {
      "name": "Transaction Status",
      "description": "Consulta del estado CBS de una transacción previa."
    }
  ],
  "paths": {
    "/v1/cbs/accounts/list": {
      "post": {
        "tags": [
          "Account Provider"
        ],
        "operationId": "listAccounts",
        "summary": "List Accounts",
        "description": "Obtiene las cuentas asociadas al número móvil y elegibles para el flujo.",
        "x-architecture-mapping": [
          "WJ24",
          "JN24"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/ChannelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListAccountsRequest"
              },
              "examples": {
                "peru_mobile": {
                  "value": {
                    "mobileNumber": "+51987654321"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado CBS del descubrimiento de cuentas",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAccountsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/cbs/cards/validate": {
      "post": {
        "tags": [
          "Account Provider"
        ],
        "operationId": "validateCardDetails",
        "summary": "Validate Card Details",
        "description": "Verifica los últimos seis dígitos, la cuenta asociada y la expiración. No realiza movimientos financieros.",
        "x-architecture-mapping": [
          "TP08"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/ChannelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateCardRequest"
              },
              "examples": {
                "card_validation": {
                  "value": {
                    "cardNumber": "123456",
                    "accountIdentifier": "1912345678901234",
                    "expiry": "1228"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado CBS de la validación",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateCardResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/cbs/accounts/balance": {
      "post": {
        "tags": [
          "Account Provider"
        ],
        "operationId": "getAccountBalance",
        "summary": "Balance Enquiry",
        "description": "Obtiene el saldo disponible autoritativo desde CBS.",
        "x-architecture-mapping": [
          "WJ12"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/ChannelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BalanceEnquiryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado CBS de la consulta de saldo",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceEnquiryResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/cbs/transactions/credit": {
      "post": {
        "tags": [
          "Money Movement"
        ],
        "operationId": "creditMoney",
        "summary": "Credit Money",
        "description": "Acredita fondos, revierte un débito o procesa un reembolso según `type`. `gatewayTransactionId` es la clave de idempotencia CBS indicada por Juspay.",
        "x-architecture-mapping": [
          "TP03",
          "TP04"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/ChannelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreditMoneyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado CBS del crédito, reversa o reembolso",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditMoneyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/cbs/transactions/debit": {
      "post": {
        "tags": [
          "Money Movement"
        ],
        "operationId": "debitMoney",
        "summary": "Debit Money",
        "description": "Debita fondos para una transacción normal o un mandato. El campo `gatewayTransactionId` es la clave de idempotencia CBS indicada por Juspay.",
        "x-architecture-mapping": [
          "TP02"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/ChannelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DebitMoneyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado CBS del débito",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DebitMoneyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/cbs/transactions/status": {
      "post": {
        "tags": [
          "Transaction Status"
        ],
        "operationId": "checkTransactionStatus",
        "summary": "Status Check",
        "description": "Consulta el estado CBS de un débito, crédito o reversa de débito.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationId"
          },
          {
            "$ref": "#/components/parameters/ChannelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado CBS de la consulta de estado",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusCheckResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key entregada al Issuer Switch y validada por Apigee."
      },
      "mutualTLS": {
        "type": "mutualTLS",
        "description": "Certificado cliente validado en las capas Akamai/Apigee."
      }
    },
    "parameters": {
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": true,
        "description": "Convención de trazabilidad de la arquitectura; no está definida en el PDF.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ChannelId": {
        "name": "X-Channel-Id",
        "in": "header",
        "required": true,
        "description": "Identificador del consumidor externo.",
        "schema": {
          "type": "string",
          "const": "NIUBIZ_JUSPAY"
        }
      }
    },
    "headers": {
      "CorrelationId": {
        "description": "Identificador de trazabilidad recibido en la solicitud.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "ListAccountsRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mobileNumber"
        ],
        "properties": {
          "mobileNumber": {
            "type": "string",
            "minLength": 8,
            "maxLength": 20,
            "description": "Número móvil registrado en CBS usado para descubrir cuentas."
          }
        }
      },
      "ListAccountsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "responseCode",
          "responseMessage"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ProcessingStatus"
          },
          "responseCode": {
            "$ref": "#/components/schemas/ResponseCode"
          },
          "responseMessage": {
            "$ref": "#/components/schemas/ResponseMessage"
          },
          "payload": {
            "$ref": "#/components/schemas/ListAccountResponsePayload"
          }
        }
      },
      "ListAccountResponsePayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cbsStatus",
          "cbsResponseCode"
        ],
        "properties": {
          "lk": {
            "type": "string",
            "description": "License Key AUA; específico de Aadhaar y candidato a omitirse en Perú.",
            "x-peru-action": "OMIT_OR_CONFIRM"
          },
          "ac": {
            "type": "string",
            "description": "Código AUA; específico de Aadhaar y candidato a omitirse en Perú.",
            "x-peru-action": "OMIT_OR_CONFIRM"
          },
          "sa": {
            "type": "string",
            "description": "Código Sub-AUA; específico de Aadhaar y candidato a omitirse en Perú.",
            "x-peru-action": "OMIT_OR_CONFIRM"
          },
          "cbsStatus": {
            "$ref": "#/components/schemas/CbsStatus"
          },
          "cbsResponseCode": {
            "$ref": "#/components/schemas/ResponseCode"
          },
          "cbsResponseMessage": {
            "$ref": "#/components/schemas/ResponseMessage"
          },
          "cbsAccounts": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/CbsAccount"
            }
          }
        }
      },
      "CbsAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountType",
          "accountNumber",
          "aadhaarEnabled",
          "name",
          "ifsc",
          "status"
        ],
        "properties": {
          "accountType": {
            "type": "string",
            "description": "Tipo de cuenta mantenido en CBS."
          },
          "accountNumber": {
            "type": "string",
            "description": "Número de cuenta fuente de verdad para postings CBS."
          },
          "aadhaarEnabled": {
            "type": "string",
            "description": "Flag textual de vinculación Aadhaar; debe localizarse para Perú.",
            "x-peru-action": "REPLACE_OR_OMIT"
          },
          "aadhaarNumber": {
            "type": "string",
            "description": "Identificador Aadhaar opcional; debe sustituirse por DNI u omitirse.",
            "x-peru-action": "REPLACE_WITH_LOCAL_ID_OR_OMIT"
          },
          "name": {
            "type": "string",
            "description": "Nombre del titular registrado en CBS."
          },
          "ifsc": {
            "type": "string",
            "description": "Código IFSC; requiere equivalencia de ruteo bancario para Perú.",
            "x-peru-action": "REPLACE_WITH_LOCAL_ROUTING_CODE"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "mmid": {
            "type": "string",
            "description": "Mobile Money Identifier opcional.",
            "x-peru-action": "OMIT_OR_CONFIRM"
          }
        }
      },
      "ValidateCardRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cardNumber",
          "accountIdentifier",
          "expiry"
        ],
        "properties": {
          "cardNumber": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "Últimos seis dígitos de la tarjeta de débito."
          },
          "accountIdentifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Número de cuenta CBS asociado a la tarjeta."
          },
          "expiry": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-2])[0-9]{2}$",
            "description": "Fecha de expiración en formato MMYY."
          }
        }
      },
      "ValidateCardResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "responseCode",
          "responseMessage"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ProcessingStatus"
          },
          "responseCode": {
            "$ref": "#/components/schemas/ResponseCode"
          },
          "responseMessage": {
            "$ref": "#/components/schemas/ResponseMessage"
          },
          "payload": {
            "$ref": "#/components/schemas/ValidateResponsePayload"
          }
        }
      },
      "ValidateResponsePayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cbsStatus",
          "cbsResponseCode"
        ],
        "properties": {
          "cbsStatus": {
            "$ref": "#/components/schemas/CbsStatus"
          },
          "cbsResponseCode": {
            "$ref": "#/components/schemas/ResponseCode"
          },
          "cbsResponseMessage": {
            "$ref": "#/components/schemas/ResponseMessage"
          }
        }
      },
      "BalanceEnquiryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountIdentifier",
          "ifsc"
        ],
        "properties": {
          "accountIdentifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Cuenta CBS cuya disponibilidad se consulta."
          },
          "ifsc": {
            "type": "string",
            "description": "Código IFSC documentado por Juspay; requiere localización para Perú.",
            "x-peru-action": "REPLACE_WITH_LOCAL_ROUTING_CODE"
          }
        }
      },
      "BalanceEnquiryResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "responseCode",
          "responseMessage"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ProcessingStatus"
          },
          "responseCode": {
            "$ref": "#/components/schemas/ResponseCode"
          },
          "responseMessage": {
            "$ref": "#/components/schemas/ResponseMessage"
          },
          "payload": {
            "$ref": "#/components/schemas/GetAccountBalanceResponsePayload"
          }
        }
      },
      "GetAccountBalanceResponsePayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "availableBalance",
          "cbsStatus",
          "cbsResponseCode"
        ],
        "properties": {
          "availableBalance": {
            "$ref": "#/components/schemas/Amount"
          },
          "cbsStatus": {
            "$ref": "#/components/schemas/CbsStatus"
          },
          "cbsResponseCode": {
            "$ref": "#/components/schemas/ResponseCode"
          },
          "cbsResponseMessage": {
            "$ref": "#/components/schemas/ResponseMessage"
          }
        }
      },
      "CreditMoneyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount",
          "gatewayReferenceId",
          "gatewayTransactionId",
          "payeeAccountNumber",
          "payeeName",
          "type"
        ],
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "gatewayReferenceId": {
            "$ref": "#/components/schemas/GatewayReferenceId"
          },
          "gatewayTransactionId": {
            "$ref": "#/components/schemas/GatewayTransactionId"
          },
          "orgGatewayReferenceId": {
            "$ref": "#/components/schemas/GatewayReferenceId"
          },
          "orgGatewayTransactionId": {
            "$ref": "#/components/schemas/GatewayTransactionId"
          },
          "isDirectCredit": {
            "type": "string",
            "description": "Flag booleano recibido como texto según el documento fuente."
          },
          "payeeAccountNumber": {
            "type": "string"
          },
          "payerAccountNumber": {
            "type": "string"
          },
          "payeeVpa": {
            "type": "string"
          },
          "payerVpa": {
            "type": "string"
          },
          "payerAcType": {
            "type": "string"
          },
          "payeeAcType": {
            "type": "string"
          },
          "payerIfsc": {
            "type": "string",
            "x-peru-action": "REPLACE_WITH_LOCAL_ROUTING_CODE"
          },
          "payeeIfsc": {
            "type": "string",
            "x-peru-action": "REPLACE_WITH_LOCAL_ROUTING_CODE"
          },
          "payerMcc": {
            "type": "string"
          },
          "payeeMcc": {
            "type": "string"
          },
          "payerName": {
            "type": "string"
          },
          "payeeName": {
            "type": "string"
          },
          "remarks": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "TRANSACTION",
              "DEBIT_REVERSAL",
              "REFUND"
            ]
          },
          "transactionTimestamp": {
            "type": "string",
            "description": "Timestamp NPCI en IST según el documento; zona horaria pendiente para Perú.",
            "x-peru-action": "CONFIRM_TIMEZONE_AND_FORMAT"
          },
          "udfParameters": {
            "type": "string",
            "description": "Parámetros de rechazo o excepción, por ejemplo DECLINED-Credit_txn_limit_exceeded."
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "REFUND"
                }
              }
            },
            "then": {
              "required": [
                "orgGatewayTransactionId"
              ],
              "properties": {
                "orgGatewayTransactionId": {
                  "$ref": "#/components/schemas/GatewayTransactionId"
                }
              }
            }
          }
        ]
      },
      "CreditMoneyResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "responseCode",
          "responseMessage"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ProcessingStatus"
          },
          "responseCode": {
            "$ref": "#/components/schemas/ResponseCode"
          },
          "responseMessage": {
            "$ref": "#/components/schemas/ResponseMessage"
          },
          "payload": {
            "$ref": "#/components/schemas/CreditResponsePayload"
          },
          "udfParameters": {
            "type": "string"
          }
        }
      },
      "CreditResponsePayload": {
        "type": "object",
        "additionalProperties": false,
